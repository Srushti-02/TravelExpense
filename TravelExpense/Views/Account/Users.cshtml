@model IEnumerable<TravelExpense.Models.User>

<h1>Users</h1>

@if (ViewBag.Message != null)
{
    <h3>@ViewBag.Message</h3>
}

@if (ViewBag.Connection != null)
{
    <div><strong>Connection:</strong> @ViewBag.Connection</div>
}

<p>
    <a asp-controller="Account" asp-action="Register">Register new user</a>
</p>

<table>
    <thead>
        <tr>
            <th>UserId</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.UserId</td>
            <td>@u.Name</td>
            <td>@u.Email</td>
            <td>@u.Role</td>
        </tr>
    }
    </tbody>
</table>
